+/// Merged bionic sysroot dir: NDK usr/include with the arch-specific subdir
+/// flattened in, plus a nullability shim. Set BIONIC_SYSROOT_INC to use.
+fn bionicSysrootInclude(b: *std.Build) ?[]const u8 {
+    const path = b.graph.environ_map.get("BIONIC_SYSROOT_INC") orelse return null;
+    return path;
+}
+
+/// NDK sysroot lib dir for the target triple (bionic libc contains dl/pthread/m).
+fn bionicSysrootLib(b: *std.Build, target: std.Build.ResolvedTarget) ?[]const u8 {
+    if (!target.result.abi.isAndroid()) return null;
+    const home = b.graph.environ_map.get("ANDROID_NDK_HOME") orelse return null;
+    const triple: []const u8 = switch (target.result.cpu.arch) {
+        .aarch64 => "aarch64-linux-android",
+        .x86_64 => "x86_64-linux-android",
+        else => return null,
+    };
+    return b.fmt("{s}/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/{s}", .{ home, triple });
+}
+
 fn addTranslatedCImports(
     b: *std.Build,
     module: *std.Build.Module,
     optimize: std.builtin.OptimizeMode,
     target: std.Build.ResolvedTarget,
 ) void {
+    const bionic_inc = bionicSysrootInclude(b);
     const miniaudio_translate = b.addTranslateC(.{
-        .root_source_file = b.path("src/vendor/miniaudio/miniaudio.h"),
+        // Bionic: shimmed entry point inside the merged sysroot (nulls nullability macros)
+        .root_source_file = if (bionic_inc != null)
+            .{ .cwd_relative = b.fmt("{s}/__opentui/miniaudio_shimmed.h", .{bionic_inc.?}) }
+        else
+            b.path("src/vendor/miniaudio/miniaudio.h"),
         .target = target,
         .optimize = optimize,
     });
+    if (bionic_inc) |inc| {
+        // Merged bionic sysroot (shimmed headers inside) replaces Zig's missing bionic libc headers
+        miniaudio_translate.addIncludePath(.{ .cwd_relative = inc });
+    }
     miniaudio_translate.addIncludePath(b.path("src"));
     module.addImport("miniaudio", miniaudio_translate.createModule());
 
     const yoga_dep = b.dependency("yoga", .{});
     const yoga_translate = b.addTranslateC(.{
-        .root_source_file = yoga_dep.path("yoga/Yoga.h"),
+        .root_source_file = if (bionic_inc != null)
+            .{ .cwd_relative = b.fmt("{s}/__opentui/Yoga_shimmed.h", .{bionic_inc.?}) }
+        else
+            yoga_dep.path("yoga/Yoga.h"),
         .target = target,
         .optimize = optimize,
     });
+    if (bionic_inc) |inc| yoga_translate.addIncludePath(.{ .cwd_relative = inc });
     yoga_translate.addIncludePath(yoga_dep.path(""));
     module.addImport("yoga", yoga_translate.createModule());
 }
